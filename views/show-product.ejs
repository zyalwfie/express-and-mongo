<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/css/output.css" />
  <title>Product Detail |
    <%= product.name %>
  </title>
</head>

<body>
  <%- include('partials/header.ejs') %>
  <% if (successMessage) { %>
   <%- include('partials/success-toast.ejs', {successMessage}) %>
  <% } %>
  <section class="bg-white dark:bg-gray-900">
    <div class="py-8 px-4 mx-auto max-w-2xl lg:py-16 mt-20">
      <h2 class="mb-2 text-xl font-semibold text-gray-900 md:text-2xl dark:text-white">
        <%= product.name %>
      </h2>
      <p class="mb-4 text-xl font-extrabold text-gray-900 md:text-2xl dark:text-white">
        Rp
        <%= new Intl.NumberFormat('id-ID').format(product.price); %>
      </p>
      <dl>
        <dt class="mb-2 font-semibold text-gray-900 dark:text-white">
          Details </dt>
        <dd class="mb-4 font-light text-gray-500 sm:mb-5 dark:text-gray-400">
          <%= product.description %>
        </dd>
      </dl>
      <dl class="flex items-center space-x-6">
        <div>
          <dt class="mb-2 font-semibold text-gray-900 dark:text-white">
            Size </dt>
          <dd class="mb-4 font-light text-gray-500 sm:mb-5 dark:text-gray-400">
            <% product.size.forEach(size=> { %>
            <%= size %>,
            <% }) %>
          </dd>
        </div>
        <div>
          <dt class="mb-2 font-semibold text-gray-900 dark:text-white">
            Stock
          </dt>
          <dd class="mb-4 font-light text-gray-500 sm:mb-5 dark:text-gray-400">
            <%= product.stock %>
          </dd>
        </div>
        <div>
          <dt class="mb-2 font-semibold text-gray-900 dark:text-white">
            Brand
          </dt>
          <dd class="mb-4 font-light text-gray-500 sm:mb-5 dark:text-gray-400">
            <%= product.brand %>
          </dd>
        </div>
        <div>
          <dt class="mb-2 font-semibold text-gray-900 dark:text-white">
            Color
          </dt>
          <dd class="mb-4 font-light text-gray-500 sm:mb-5 dark:text-gray-400">
            <%= product.color %>
          </dd>
        </div>
        <div>
          <dt class="mb-2 font-semibold text-gray-900 dark:text-white">
            Condition
          </dt>
          <dd class="mb-4 font-light text-gray-500 sm:mb-5 dark:text-gray-400">
            <%= product.condition %>
          </dd>
        </div>
      </dl>
      <div class="flex items-center space-x-4">
        <a href="/products" class="inline-flex items-center border border-gray-800 bg-white hover:bg-gray-800 text-gray-800 focus:ring-4 focus:outline-none focus:ring-gray-300 font-medium hover:text-white rounded-lg text-sm px-5 py-2.5 text-center dark:bg-gray-600 dark:hover:bg-gray-700 dark:focus:ring-gray-800">
          <svg class="mr-1 -ml-1 w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12l4-4m-4 4 4 4" />
          </svg>
          Back
        </a>
        <button type="button" class="text-white inline-flex items-center bg-primary-700 hover:bg-primary-800 focus:ring-4 focus:outline-none focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800">
          <svg aria-hidden="true" class="mr-1 -ml-1 w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            <path d="M17.414 2.586a2 2 0 00-2.828 0L7 10.172V13h2.828l7.586-7.586a2 2 0 000-2.828z">
            </path>
            <path fill-rule="evenodd" d="M2 6a2 2 0 012-2h4a1 1 0 010 2H4v10h10v-4a1 1 0 112 0v4a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" clip-rule="evenodd"></path>
          </svg>
          Edit
        </button>
        <button type="button" class="inline-flex items-center text-white bg-red-600 hover:bg-red-700 focus:ring-4 focus:outline-none focus:ring-red-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-red-500 dark:hover:bg-red-600 dark:focus:ring-red-900">
          <svg aria-hidden="true" class="w-5 h-5 mr-1.5 -ml-1" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path>
          </svg>
          Delete
        </button>
      </div>
    </div>
  </section>
  <%- include('partials/footer.ejs') %>
  <script src="/js/flowbite.min.js"></script>
</body>

</html>